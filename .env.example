# Exemplo de variáveis de ambiente do projeto.
# Copie este arquivo para ".env.local" e preencha com valores locais.
# NUNCA coloque aqui senhas, tokens ou dados reais da empresa.
# NUNCA faça commit do arquivo ".env.local" (ele já está no .gitignore).

NEXT_PUBLIC_APP_NAME="Central de Novos Negócios"

# Credenciais do Supabase (Project Settings > API no painel do Supabase).
# A "anon key" é pública por natureza, mas mesmo assim mantenha só no
# .env.local e nas variáveis de ambiente da Vercel — nunca no código.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
